---
/**
 * Images side by side, each with a label and an optional note: renders to compare, before/after, variants.
 *
 *     import Gallery from '@silarhi/docs-kit/components/Gallery.astro'
 *     <Gallery frame items={[{ src: contain, alt: '…', label: 'contain', note: '480×322' }]} />
 *
 * `frame` draws a checkerboard behind each image, so the empty areas of a render (bands, transparency) show.
 */
import type { ImageMetadata } from 'astro'

interface Item {
    src: ImageMetadata | string
    alt: string
    label: string
    note?: string
}

interface Props {
    items: Item[]
    /** Minimum width of a column, the grid fits as many as the page allows. */
    minWidth?: string
    frame?: boolean
    caption?: string
}

const { items, minWidth = '10rem', frame = false, caption } = Astro.props
const url = (src: Item['src']) => (typeof src === 'string' ? src : src.src)
---

<figure class="sl-gallery not-content">
    <div class="grid" style={`--min: ${minWidth}`}>
        {
            items.map((item) => (
                <div class="item">
                    <div class:list={['media', { frame }]}>
                        <img src={url(item.src)} alt={item.alt} loading="lazy" decoding="async" />
                    </div>
                    <div class="label">{item.label}</div>
                    {item.note && <div class="note">{item.note}</div>}
                </div>
            ))
        }
    </div>
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .sl-gallery {
        margin-block: 1.5rem;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(var(--min), 100%), 1fr));
        gap: 1rem;
    }
    .item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .media {
        border: 1px solid var(--sl-color-hairline);
        border-radius: 0.5rem;
        overflow: hidden;
        background: var(--sl-color-gray-6);
    }
    .media img {
        display: block;
        width: 100%;
        height: auto;
    }
    .media.frame {
        --check: var(--sl-color-gray-5);
        background-color: var(--sl-color-gray-6);
        background-image:
            linear-gradient(45deg, var(--check) 25%, transparent 25%),
            linear-gradient(-45deg, var(--check) 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, var(--check) 75%),
            linear-gradient(-45deg, transparent 75%, var(--check) 75%);
        background-size: 16px 16px;
        background-position:
            0 0,
            0 8px,
            8px -8px,
            -8px 0;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
    }
    .media.frame img {
        width: auto;
        max-width: 100%;
        max-height: 100%;
    }
    .label {
        font-family: var(--__sl-font-mono);
        font-size: var(--sl-text-sm);
        font-weight: 600;
        color: var(--sl-color-white);
    }
    .note {
        font-size: var(--sl-text-xs);
        color: var(--sl-color-gray-3);
    }
    figcaption {
        margin-top: 0.75rem;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }
</style>

{
    "name": "@silarhi/docs-kit",
    "version": "0.10.0",
    "description": "Shared Starlight preset for the documentation of SILARHI open-source packages",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/silarhi/docs-kit.git",
        "directory": "packages/docs-kit"
    },
    "homepage": "https://docs.silarhi.dev",
    "exports": {
        ".": "./index.ts",
        "./content": "./content.ts",
        "./packages": "./packages.js",
        "./route-middleware": "./route-middleware.ts",
        "./styles/*": "./styles/*",
        "./components/*": "./components/*",
        "./assets/*": "./assets/*"
    },
    "files": [
        "index.ts",
        "content.ts",
        "packages.js",
        "virtual.d.ts",
        "seo.ts",
        "og-image.ts",
        "route-middleware.ts",
        "scripts",
        "styles",
        "components",
        "assets"
    ],
    "keywords": [
        "starlight",
        "astro",
        "documentation",
        "silarhi",
        "withastro"
    ],
    "dependencies": {
        "@fontsource-variable/montserrat": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "satori": "^0.63.2",
        "starlight-llms-txt": "^0.12.0",
        "starlight-versions": "^0.10.1"
    },
    "peerDependencies": {
        "@astrojs/starlight": ">=0.42.0",
        "astro": "^7.2.10"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
